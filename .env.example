# Environment variables for Docker Compose
# Copy this file to .env.local and customize as needed

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=irc_db

# API Configuration
API_SECRET=api_secret #! Use different password than individual repos to verify proper pulling

# Velocity Configuration
VELOCITY_SECRET=velocity_secret #! Use different password than individual repos to verify proper pulling

# Ports
BACKEND_PORT=3000
ADMIN_PANEL_PORT=5000
FILE_BROWSER_PORT=8080
VELOCITY_PORT=25565

# Application Configuration (for future services)
NODE_ENV=development
