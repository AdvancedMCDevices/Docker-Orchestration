# Environment variables for Docker Compose
# Copy this file to .env.local and customize as needed

# PostgreSQL Configuration
POSTGRES_USER=postgres
# WARNING: Change this to a strong password in production!
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=amcd_db

# Network Configuration
COMPOSE_PROJECT_NAME=amcd-services

# Service Ports
POSTGRES_PORT=5432
WEBAPP_PORT=8080
API_PORT=3000
REDIS_PORT=6379

# Application Configuration (for future services)
NODE_ENV=development
