# Environment variables for Docker Compose
# Copy this file to .env.local and customize as needed

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=irc_db

# API Configuration
API_SECRET=super_duper_secure_secret

# Velocity Configuration
VELOCITY_SECRET=super_duper_secure_secret_the_second

# Ports
BACKEND_PORT=3000
ADMIN_PANEL_PORT=5000
FILE_BROWSER_PORT=8080
VELOCITY_PORT=25565

# Application Configuration (for future services)
NODE_ENV=development
